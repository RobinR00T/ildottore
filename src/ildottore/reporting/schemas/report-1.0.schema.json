{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ildottore.dev/schemas/report-1.0.schema.json",
  "title": "Il Dottore canonical report (u11 \u00a76)",
  "description": "Lossless canonical JSON report: the run, its findings and the aggregated summary. All strings are redactor-masked before serialization (u11 \u00a72). Versioning: report-1.0 grows additively. A key a later build adds is optional here, so a report an earlier build wrote validates against this copy, and a consumer validating a newer report needs the newer copy. The run and each finding name the keys every build since report-1.0 writes and the types, values and ranges the models that write them enforce (a verdict's status, a risk's band and figures), and leave the rest open (additionalProperties true), so neither an older report nor a newer key fails them (u11 and u12 A-82, CLI audit L5). dottore schema export --name report prints this document; dottore diff reads schema_version 1 or 1.<minor>.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run",
    "findings",
    "summary"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "run": {
      "description": "The run: its id, the targets it scanned (as their files declared them, the credential a reference only), its findings (the same list as the top-level findings) and the authorization record's digest.",
      "type": "object",
      "additionalProperties": true,
      "required": [
        "run_id",
        "targets",
        "findings",
        "summary"
      ],
      "properties": {
        "run_id": {
          "type": "string"
        },
        "suite_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "targets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": [
              "id",
              "type"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "type": {
                "enum": [
                  "model",
                  "chatbot",
                  "api",
                  "agent",
                  "rag"
                ]
              }
            }
          }
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/finding"
          }
        },
        "summary": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "by_status": {
              "type": "object",
              "additionalProperties": {
                "type": "integer",
                "minimum": 0
              }
            },
            "by_band": {
              "type": "object",
              "additionalProperties": {
                "type": "integer",
                "minimum": 0
              }
            },
            "by_category": {
              "type": "object",
              "additionalProperties": {
                "type": "integer",
                "minimum": 0
              }
            },
            "total": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "started_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "finished_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "scope_sha256": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/finding"
      }
    },
    "summary": {
      "$ref": "#/definitions/runSummary"
    }
  },
  "definitions": {
    "runSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total",
        "by_status",
        "by_band",
        "by_framework",
        "repro_distribution",
        "confidence_distribution",
        "confirmed_count",
        "needs_review_count",
        "coverage"
      ],
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "by_status": {
          "$ref": "#/definitions/countMap"
        },
        "by_band": {
          "$ref": "#/definitions/countMap"
        },
        "by_framework": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "owasp",
            "atlas",
            "nist"
          ],
          "properties": {
            "owasp": {
              "$ref": "#/definitions/countMap"
            },
            "atlas": {
              "$ref": "#/definitions/countMap"
            },
            "nist": {
              "$ref": "#/definitions/countMap"
            }
          }
        },
        "model_comparison": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "spec_ids",
            "target_ids",
            "cells",
            "category_rollups"
          ],
          "properties": {
            "spec_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "target_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "cells": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "spec_id",
                  "target_id",
                  "band",
                  "reproducibility",
                  "confidence"
                ],
                "properties": {
                  "spec_id": {
                    "type": "string"
                  },
                  "target_id": {
                    "type": "string"
                  },
                  "band": {
                    "type": "string"
                  },
                  "reproducibility": {
                    "type": "number"
                  },
                  "confidence": {
                    "type": "number"
                  }
                }
              }
            },
            "category_rollups": {
              "type": "object"
            }
          }
        },
        "repro_distribution": {
          "$ref": "#/definitions/distribution"
        },
        "confidence_distribution": {
          "$ref": "#/definitions/distribution"
        },
        "confirmed_count": {
          "type": "integer",
          "minimum": 0
        },
        "needs_review_count": {
          "type": "integer",
          "minimum": 0
        },
        "coverage": {
          "$ref": "#/definitions/coverage"
        },
        "status": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "complete"
          ],
          "description": "Whether the run finished. Optional in report-1.0 so a document written by an earlier build still validates; always emitted by this one. state is complete, budget_exhausted (a hard ceiling halted the campaign), aborted (an error stopped it: a non-retryable 4xx, or a run whose first replies could all not be read) or unreachable (every attempt failed on transport or got a reply that could not be read, so nothing was evaluated).",
          "properties": {
            "state": {
              "type": "string",
              "minLength": 1
            },
            "complete": {
              "type": "boolean"
            },
            "reason": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "blocked_by_provider_filter": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "attempts",
            "specs"
          ],
          "description": "The attempts the provider's own input filter refused before the model saw them (OD-41, ADR-0011): Azure OpenAI's HTTP 400 content_filter, Gemini's promptFeedback.blockReason. Each is an inconclusive attempt with the reason blocked_by_provider_filter, neither the model's refusal nor an exploit; specs lists the spec ids with at least one. Optional in report-1.0 so a document written by an earlier build still validates; always emitted by this one.",
          "properties": {
            "attempts": {
              "type": "integer",
              "minimum": 0
            },
            "specs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "cut_by_provider_output_filter": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "attempts",
            "specs"
          ],
          "description": "The attempts whose reply the provider's own output filter cut or replaced after the model wrote it (OD-42, ADR-0011 amendment): Azure OpenAI's finish_reason content_filter, Gemini's candidate finishReason SAFETY, Anthropic's stop_reason refusal after some output, a Bedrock guardrail whose trace shows an output assessment. Each is an inconclusive attempt with the reason cut_by_provider_output_filter, needing review: the model may have written what the filter hid, so it is never the model's refusal; specs lists the spec ids with at least one. Optional in report-1.0 so a document written by an earlier build still validates; always emitted by this one.",
          "properties": {
            "attempts": {
              "type": "integer",
              "minimum": 0
            },
            "specs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "provider_filter_side_unknown": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "attempts",
            "specs"
          ],
          "description": "The attempts whose reply the provider's filter stopped without saying whether it refused the prompt or cut the reply (OD-42): a Bedrock guardrail_intervened with no guardrail trace, Bedrock's content_filtered. Each is an inconclusive attempt with the reason provider_filter_side_unknown, needing review and never a pass. Optional in report-1.0; always emitted by this build.",
          "properties": {
            "attempts": {
              "type": "integer",
              "minimum": 0
            },
            "specs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "unreadable_reply": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "attempts",
            "specs"
          ],
          "description": "The attempts whose reply the adapter could not read as the provider's (OD-21, ADR-0012, u08 A-74): a success body that is not JSON, not a JSON object or not the provider's or the template's shape, a WebSocket frame or an MCP reply of that kind. Each is an inconclusive attempt with the reason unreadable_reply, its spec never a pass: the reply that broke may be the one an attack changed; the attempt keeps a redacted excerpt of the body under request.metadata.unreadable_reply. specs lists the spec ids with at least one. Optional in report-1.0 so a document written by an earlier build still validates; always emitted by this one.",
          "properties": {
            "attempts": {
              "type": "integer",
              "minimum": 0
            },
            "specs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "operator_declarations": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "not_destructive_tools",
            "attempts",
            "specs"
          ],
          "description": "What the operator's target files declare of the deployments' own tools (OD-43, u06 A-72): an operator declaration, not a finding. not_destructive_tools maps each target id whose file declares any to the granted tools it declares not destructive (seeded_setup.granted_tools entries {name, destructive: false}); tool_call does not fail a call to one by its name alone, and nothing else changes. attempts counts the attempts whose verdict that declaration changed (their reasoning says which tool, after 'operator declaration (OD-43)'), specs lists the spec ids with at least one. Optional in report-1.0 so a document written by an earlier build still validates; always emitted by this one.",
          "properties": {
            "not_destructive_tools": {
              "type": "object",
              "additionalProperties": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "attempts": {
              "type": "integer",
              "minimum": 0
            },
            "specs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owasp",
        "atlas",
        "iopc",
        "specs"
      ],
      "properties": {
        "owasp": {
          "$ref": "#/definitions/frameworkCoverage"
        },
        "atlas": {
          "$ref": "#/definitions/frameworkCoverage"
        },
        "iopc": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "techniques",
            "impacts"
          ],
          "description": "Nova IoPC coverage on both axes: techniques (the how) and impacts (the damage).",
          "properties": {
            "techniques": {
              "$ref": "#/definitions/codeCoverage"
            },
            "impacts": {
              "$ref": "#/definitions/codeCoverage"
            },
            "edition": {
              "type": "string",
              "description": "Edition or release of the framework this axis is measured against (clause A-14). Optional in report-1.0 so an older document still validates; a consumer validating a new report needs this copy of the schema (report-1.0 grows additively)."
            }
          }
        },
        "specs": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "total",
            "run",
            "pass",
            "fail",
            "inconclusive"
          ],
          "properties": {
            "total": {
              "type": "integer",
              "minimum": 0
            },
            "run": {
              "type": "integer",
              "minimum": 0
            },
            "pass": {
              "type": "integer",
              "minimum": 0
            },
            "fail": {
              "type": "integer",
              "minimum": 0
            },
            "inconclusive": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "off_universe": {
          "type": "array",
          "description": "Framework values this run did not count because they are outside their pinned universe. Optional in report-1.0 so an older document still validates.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "spec_id",
              "field",
              "value"
            ],
            "properties": {
              "spec_id": {
                "type": "string"
              },
              "field": {
                "type": "string"
              },
              "value": {
                "type": "string"
              }
            }
          }
        },
        "not_exercised": {
          "type": "array",
          "description": "Spec ids that produced a finding but no reply that could be scored: nothing sent (policy-blocked, or skipped for an undeclared capability), or every send ended in an environment error or was refused by the provider's input filter (OD-41), or was stopped by its filter on a side it did not report (OD-42). Their framework codes are excluded from every numerator. Optional in report-1.0.",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "codeCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "codes",
        "exercised",
        "total",
        "pct"
      ],
      "description": "Coverage of a code-keyed taxonomy axis (the IoPC technique and impact axes).",
      "properties": {
        "codes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exercised": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "frameworkCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exercised",
        "total",
        "pct"
      ],
      "properties": {
        "categories": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tactics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exercised": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "edition": {
          "type": "string",
          "description": "Edition or release of the framework this axis is measured against (clause A-14). Optional in report-1.0 so an older document still validates; a consumer validating a new report needs this copy of the schema (report-1.0 grows additively)."
        }
      }
    },
    "countMap": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "distribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "count",
        "min",
        "max",
        "mean"
      ],
      "properties": {
        "count": {
          "type": "number"
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "mean": {
          "type": "number"
        }
      }
    },
    "riskScore": {
      "description": "A finding's risk (docs/05): impact and exploitability from the spec, reproducibility and confidence from the attempts, risk their product, band the risk's band.",
      "type": "object",
      "additionalProperties": true,
      "required": [
        "impact",
        "exploitability",
        "reproducibility",
        "risk",
        "band",
        "confidence"
      ],
      "properties": {
        "impact": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "exploitability": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "reproducibility": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "risk": {
          "type": "number",
          "minimum": 0,
          "maximum": 16
        },
        "band": {
          "enum": [
            "critical",
            "high",
            "medium",
            "low",
            "info"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "attempt": {
      "description": "One attempt of a spec: the request sent and, when there was one, the reply, its verdict and the error. Only what identifies it is required; its inner records stay open.",
      "type": "object",
      "additionalProperties": true,
      "required": [
        "attempt_id",
        "spec_id",
        "request"
      ],
      "properties": {
        "attempt_id": {
          "type": "string"
        },
        "spec_id": {
          "type": "string"
        },
        "mutation": {
          "type": "string"
        },
        "request": {
          "type": "object"
        },
        "response": {
          "type": [
            "object",
            "null"
          ]
        },
        "verdict": {
          "type": [
            "object",
            "null"
          ]
        },
        "sampling": {
          "type": [
            "object",
            "null"
          ]
        },
        "latency_ms": {
          "type": [
            "number",
            "null"
          ]
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "finding": {
      "description": "One spec's result on one target: its status, its risk, whether it was confirmed, the attempts behind it and their evidence.",
      "type": "object",
      "additionalProperties": true,
      "required": [
        "spec_id",
        "target_id",
        "status",
        "risk",
        "confirmed"
      ],
      "properties": {
        "spec_id": {
          "type": "string"
        },
        "target_id": {
          "type": "string"
        },
        "status": {
          "enum": [
            "pass",
            "fail",
            "inconclusive"
          ]
        },
        "risk": {
          "$ref": "#/definitions/riskScore"
        },
        "confirmed": {
          "type": "boolean"
        },
        "attempts": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/attempt"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": [
              "run_id",
              "attempt_id",
              "uri"
            ],
            "properties": {
              "run_id": {
                "type": "string"
              },
              "attempt_id": {
                "type": "string"
              },
              "uri": {
                "type": "string"
              },
              "sha256": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "reasoning": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
