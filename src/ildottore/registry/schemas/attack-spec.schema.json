{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ildottore.dev/schemas/attack-spec.schema.json",
  "title": "AttackSpec",
  "type": "object",
  "required": [
    "id",
    "spec_version",
    "name",
    "category",
    "owasp",
    "mitre_atlas",
    "nist_ai_rmf",
    "severity",
    "target_type",
    "requires",
    "description",
    "attack",
    "expected_secure_behavior",
    "evaluators",
    "scoring",
    "fixtures"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z]+(-[A-Z0-9]+)+$"
    },
    "spec_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$"
    },
    "name": {
      "type": "string",
      "minLength": 3
    },
    "category": {
      "type": "string",
      "enum": [
        "prompt_injection",
        "jailbreak",
        "data_leakage",
        "agent_tool_abuse",
        "rag_security",
        "output_security",
        "availability_cost",
        "safety_content",
        "bias_fairness"
      ]
    },
    "owasp": {
      "type": "string",
      "pattern": "^(LLM|RAI)\\d{2}$"
    },
    "mitre_atlas": {
      "type": "object",
      "required": [
        "tactic"
      ],
      "properties": {
        "tactic": {
          "type": "string"
        },
        "technique": {
          "type": "string"
        }
      }
    },
    "mitre_attack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "techniques"
      ],
      "description": "MITRE ATT&CK Enterprise mapping (docs/17): the techniques this spec exercises, each with how (observed in the target's own actions, or a capability artefact only) and optionally which of the technique's tactics the claim is restricted to. Optional so third-party spec packs keep validating. IDs are validated against the pinned release by lint, never here.",
      "properties": {
        "domain": {
          "type": "string",
          "enum": [
            "enterprise"
          ]
        },
        "techniques": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "occurrence"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^T[0-9]{4}(\\.[0-9]{3})?\\Z"
              },
              "occurrence": {
                "type": "string",
                "enum": [
                  "observed",
                  "capability-only"
                ]
              },
              "tactics": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z]+(-[a-z]+)*\\Z"
                }
              }
            }
          }
        }
      }
    },
    "nist_ai_rmf": {
      "type": "string"
    },
    "iopc": {
      "type": "object",
      "additionalProperties": false,
      "description": "Nova IoPC taxonomy mapping (docs/15). Optional so third-party spec packs keep validating; the shipped battery is required to carry it by test.",
      "properties": {
        "techniques": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^IOPC-T[1-9][0-9]*\\.[0-9]{3}\\Z"
          }
        },
        "impacts": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^IOPC-R[0-9]{3}\\Z"
          }
        }
      }
    },
    "aisvs": {
      "type": "array",
      "description": "OWASP AISVS 1.0 requirement IDs (v1.0-C<chapter>.<section>.<n>) whose control a FAIL of this spec is evidence against. Falsification only: a PASS never verifies a control. IDs only; the requirement text is CC-BY-SA and is not reproduced. Optional, so third-party spec packs keep validating.",
      "items": {
        "type": "string",
        "pattern": "^v1\\.0-C[1-9][0-9]?\\.[1-9][0-9]?\\.[1-9][0-9]?\\Z"
      }
    },
    "severity": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "target_type": {
      "type": "string",
      "enum": [
        "model",
        "chatbot",
        "api",
        "agent",
        "rag"
      ]
    },
    "requires": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "rag",
          "tools",
          "memory",
          "system_prompt",
          "streaming",
          "logprobs",
          "multi_identity",
          "multimodal",
          "audio",
          "mcp",
          "mcp_pins"
        ]
      },
      "description": "Capabilities the target must offer for the spec to run. mcp: the target is an MCP server (provider mcp), whose advertised surface the read-only MCP adapter renders (OD-44). mcp_pins: the MCP target pins its catalogue (mcp.pins), which the adapter compares against what the server advertises (u04 A-101)."
    },
    "description": {
      "type": "string"
    },
    "preconditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "setup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "documents": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "destructive": {
                "type": ["boolean", "null"],
                "description": "true: tool_call treats a call to this tool as destructive whatever its name; false: not destructive whatever its name (a hand-off such as transfer_to_billing_agent); absent or null: a destructive verb in the name decides (u06 A-71)"
              },
              "external": {
                "type": ["boolean", "null"],
                "description": "true: egress, never authorized by an allowlist taken from the setup; false, absent or null: not egress"
              }
            }
          }
        },
        "memory_seed": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "system_prompt": {
          "type": "string"
        },
        "canaries": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "attack": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "user_prompt": {
          "type": "string"
        },
        "carrier": {
          "type": "string"
        },
        "turns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "media": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "image",
                  "audio"
                ]
              },
              "format": {
                "type": "string",
                "enum": [
                  "png",
                  "wav"
                ]
              },
              "render_text": {
                "type": "string"
              },
              "data_b64": {
                "type": "string"
              },
              "asset": {
                "type": "string"
              },
              "scale": {
                "type": "integer",
                "minimum": 1,
                "maximum": 16
              },
              "columns": {
                "type": "integer",
                "minimum": 1,
                "maximum": 256
              },
              "alt": {
                "type": "string"
              }
            }
          }
        }
      },
      "anyOf": [
        {
          "required": [
            "user_prompt"
          ]
        },
        {
          "required": [
            "carrier"
          ]
        },
        {
          "required": [
            "turns"
          ]
        }
      ]
    },
    "mutations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "expected_secure_behavior": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "evaluators": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "regex_absence",
              "regex_presence",
              "exact_match",
              "refusal",
              "secret_leakage",
              "tool_call",
              "tool_sequence",
              "semantic_judge",
              "pii_detector",
              "secret_shape",
              "verbatim_overlap",
              "logprob_membership",
              "authz_leak",
              "kill_chain_progression"
            ]
          },
          "patterns": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "forbidden_args": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "forbidden_arg_values": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "tool_call only: regex per argument name; a call whose value under that name (at any depth, numbers and booleans in their JSON spelling) matches is the exploit."
          },
          "step_arg_patterns": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "tool_sequence only: regex per step tool name; that step counts only if a tool-call argument value matches."
          },
          "rubric": {
            "type": "string"
          },
          "canary_ref": {
            "type": "string"
          },
          "weight": {
            "type": "number",
            "description": "Deprecated (OD-19): read by nothing. It weighted a vote that no run path took; dottore lint warns."
          }
        }
      }
    },
    "evaluator_logic": {
      "type": "string",
      "enum": [
        "deterministic_first",
        "all_pass",
        "any_fail",
        "weighted"
      ],
      "description": "How the evaluators' verdicts combine. One rule, deterministic_first: a deterministic fail decides; else an inconclusive; else a fail of semantic_judge alone (reported, never confirmed); else pass. all_pass, any_fail and weighted are deprecated names of it (OD-19, ADR-0010); dottore lint warns."
    },
    "scoring": {
      "type": "object",
      "required": [
        "impact",
        "exploitability",
        "confidence_threshold"
      ],
      "additionalProperties": false,
      "properties": {
        "impact": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "exploitability": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "confidence_threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "runs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50
    },
    "sampling": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "temperature": {
          "type": "number"
        },
        "top_p": {
          "type": "number"
        },
        "seed": {
          "type": "integer"
        },
        "max_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200000
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200000
        },
        "max_requests": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "timeout_s": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        }
      }
    },
    "test_only": {
      "type": "boolean"
    },
    "requires_policy": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Engagement capabilities this spec requires to run; each must be present in the scope pack's enabled_capabilities or the spec is blocked_by_policy (OFF by default). Seed values: offensive_simulation, layer_b_pii."
    },
    "fixtures": {
      "type": "object",
      "required": [
        "vulnerable",
        "hardened"
      ],
      "additionalProperties": false,
      "properties": {
        "vulnerable": {
          "type": "object",
          "required": [
            "response",
            "expect_verdict"
          ],
          "properties": {
            "response": {
              "type": "string"
            },
            "tool_calls": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "expect_verdict": {
              "type": "string",
              "enum": [
                "fail"
              ]
            }
          }
        },
        "hardened": {
          "type": "object",
          "required": [
            "response",
            "expect_verdict"
          ],
          "properties": {
            "response": {
              "type": "string"
            },
            "tool_calls": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "expect_verdict": {
              "type": "string",
              "enum": [
                "pass"
              ]
            }
          }
        }
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
