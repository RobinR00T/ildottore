# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.env
.python-version

# Tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.hypothesis/
.import_linter_cache/

# Il Dottore runtime artifacts (never commit scan output / evidence - may contain findings).
# Root-anchored so test snapshot fixtures under tests/**/fixtures/ are NOT ignored.
/reports/
/evidence/
/runs/
*.sarif
# Re-include SARIF fixtures under tests/. This comment has a line of its own because git reads
# no trailing comments: after a pattern, it would become part of the pattern.
!tests/**/*.sarif
/scope.yaml
!specs/scope.example.yaml

# OS / editor
.DS_Store
.idea/
.vscode/

# Il Dottore default run output (evidence + run db) - never version runtime artifacts
/.dottore/
