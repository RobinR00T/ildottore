# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
# No trailing slash: a worktree's .venv is a symlink to the main checkout's, and git sees a
# symlink as a file, which a directory-only pattern does not match.
.venv
venv/
.env
.python-version

# Tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.hypothesis/
.import_linter_cache/

# Il Dottore runtime artifacts (never commit scan output / evidence - may contain findings).
# Root-anchored so test snapshot fixtures under tests/**/fixtures/ are NOT ignored.
/reports/
/evidence/
/runs/
*.sarif
!tests/**/*.sarif          # keep committed SARIF snapshot fixtures
/scope.yaml
!specs/scope.example.yaml

# OS / editor
.DS_Store
.idea/
.vscode/

# Il Dottore default run output (evidence + run db) - never version runtime artifacts
/.dottore/
